# Copiar para .env e preencher os valores
# O ficheiro .env nunca deve ser commitado (está no .gitignore)

FLASK_ENV=development
SECRET_KEY=gera-uma-chave-forte-aqui

# Wise API
WISE_API_KEY=your_wise_api_key_here

# Notificações — Telegram
# Obter em: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Notificações — Mailjet
# Obter em: https://app.mailjet.com/settings/api_keys
MAILJET_API_KEY=<sua_api_key>
MAILJET_API_SECRET=<seu_api_secret>
MAILJET_FROM_EMAIL=pipe.notificacoes@outlook.com


# Assistente de IA
# Obter em openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free

# Combustíveis — API Aberta (api.apiaberta.pt)
# Obter em: https://api.apiaberta.pt (registo para gerar a chave)
# Opcional — sem chave o módulo funciona no tier anónimo (30 pedidos/min);
# com chave sobe para 300 pedidos/min. Reiniciar/Reload depois de alterar.
APIABERTA_API_KEY=

# Cofre de Passwords — CORS da extensão Chrome
# Instalar a extensão (chrome://extensions → Load unpacked → pasta chrome-extension/)
# e copiar o ID que aparece na página da extensão para aqui:
#   COFRE_CORS_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Vários IDs separados por vírgula. Sem valor, o Cofre funciona no browser mas a
# extensão é bloqueada por CORS. Serve para produção e para desenvolvimento: para
# testar localmente basta usar o ID da extensão e apontá-la ao servidor local
# (chrome.storage.local.pipeOrigin) — ver docs/guia-extensao-chrome.md, Passo 8.
COFRE_CORS_ORIGINS=
